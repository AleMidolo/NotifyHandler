{
  "name": "notify-handler",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "notify-handler",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "6.0.3"
      },
      "engines": {
        "node": "24.21.x",
        "npm": "11.19.x"
      }
